#!/usr/bin/env bash
#MISE description="Run BATS unit tests"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" default="" var=#true help="BATS files, directories, and arguments"
#USAGE example "mise run test" header="Run all unit tests serially"
#USAGE example "mise run test test/status.bats" header="Run one BATS test file"
#USAGE example "mise run test --filter signing" header="Filter tests by name"
set -euo pipefail

export BATS_DEFAULT_TEST_TARGET="$MISE_CONFIG_ROOT/test"
export BATS_NUMBER_OF_PARALLEL_JOBS="${BATS_NUMBER_OF_PARALLEL_JOBS:-1}"

exec bats --print-output-on-failure "$@"
