#!/usr/bin/env bash
#MISE description="Reply to an email"
#USAGE arg "<id>" help="Message number (from inbox) or full message ID"
#USAGE flag "--body <body>" help="Reply body text (required)"
#USAGE flag "--all" help="Reply all"
#USAGE flag "--confirm" help="Skip confirmation prompt"
#USAGE flag "--json" help="Output raw JSON"
set -eo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "$REPO_DIR/lib/graph.sh"

msg_ref="${usage_id:?Usage: email reply <number|message_id> --body \"Reply text\"}"
body="${usage_body:?Missing --body}"

# Resolve message number to ID
if [[ "$msg_ref" =~ ^[0-9]+$ ]] && [ "$msg_ref" -le 200 ]; then
  idx=$((msg_ref - 1))
  inbox=$(graph_get "/me/mailFolders/inbox/messages?\$top=$((idx + 1))&\$orderby=receivedDateTime%20desc&\$select=id,subject,from")

  msg_id=$(echo "$inbox" | jq -r ".value[$idx].id // empty")
  if [ -z "$msg_id" ]; then
    echo "Message #$msg_ref not found." >&2
    exit 1
  fi

  subject=$(echo "$inbox" | jq -r ".value[$idx].subject // \"(no subject)\"")
  from=$(echo "$inbox" | jq -r ".value[$idx].from.emailAddress.name // .value[$idx].from.emailAddress.address // \"unknown\"")
else
  msg_id="$msg_ref"
  msg_info=$(graph_get "/me/messages/$msg_id?\$select=subject,from")
  subject=$(echo "$msg_info" | jq -r '.subject // "(no subject)"')
  from=$(echo "$msg_info" | jq -r '.from.emailAddress.name // .from.emailAddress.address // "unknown"')
fi

# Confirm
if [ "${usage_confirm:-}" != "true" ]; then
  action="Reply"
  [ "${usage_all:-}" = "true" ] && action="Reply All"

  echo "$action to:"
  echo "  From:    $from"
  echo "  Subject: $subject"
  echo ""
  echo "Your reply:"
  echo "  $body"
  echo ""
  read -rp "Send? [y/N] " answer
  if [[ ! "$answer" =~ ^[yY] ]]; then
    echo "Cancelled."
    exit 0
  fi
fi

payload=$(jq -n --arg body "$body" '{comment: $body}')

endpoint="/me/messages/$msg_id/reply"
[ "${usage_all:-}" = "true" ] && endpoint="/me/messages/$msg_id/replyAll"

response=$(graph_post "$endpoint" "$payload")

if [ -z "$response" ]; then
  if [ "${usage_json:-}" = "true" ]; then
    echo '{"success": true, "message": "Reply sent"}'
  else
    echo "Reply sent."
  fi
else
  if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
    echo "Error: $(echo "$response" | jq -r '.error.message // .error')" >&2
    exit 1
  fi
  echo "Reply sent."
fi
