#!/usr/bin/env bash
#MISE description="Download attachment(s) from a message (handles nested/forwarded emails)"
#USAGE arg "<id>" help="Message number (from inbox) or full message ID"
#USAGE flag "--attachment <name>" help="Attachment filename to download (downloads all if omitted)"
#USAGE flag "--dir <path>" help="Directory to save files (default: current directory)"
#USAGE flag "--list" help="List available attachments (including nested) without downloading"
set -eo pipefail

source "$MISE_CONFIG_ROOT/lib/graph.sh"

msg_ref="${usage_id:?Usage: email download <number|message_id>}"
out_dir="${usage_dir:-.}"
filter_name="${usage_attachment:-}"
list_only="${usage_list:-false}"

# Resolve number → message ID
if [[ "$msg_ref" =~ ^[0-9]+$ ]] && [ "$msg_ref" -le 200 ]; then
  idx=$((msg_ref - 1))
  inbox=$(graph_get "/me/mailFolders/inbox/messages?\$top=$((idx + 1))&\$orderby=receivedDateTime%20desc&\$select=id")
  if echo "$inbox" | jq -e '.error' >/dev/null 2>&1; then
    echo "Error fetching inbox: $(echo "$inbox" | jq -r '.error.message // .error')" >&2
    exit 1
  fi
  msg_id=$(echo "$inbox" | jq -r ".value[$idx].id // empty")
  if [ -z "$msg_id" ]; then
    echo "Message #$msg_ref not found. Run 'email inbox' to see available messages." >&2
    exit 1
  fi
else
  msg_id="$msg_ref"
fi

# Fetch raw MIME via $value endpoint — handles all attachment types including
# nested message/rfc822 (forwarded emails with their own attachments).
# Write directly to a temp file with curl -o to preserve exact bytes (no shell variable mangling).
token=$(graph_get_token)
tmp_mime=$(mktemp)
trap 'rm -f "$tmp_mime"' EXIT
curl -sf --max-time 120 \
  -H "Authorization: Bearer $token" \
  -o "$tmp_mime" \
  "https://graph.microsoft.com/v1.0/me/messages/$msg_id/\$value" || {
  echo "Error: failed to fetch message content" >&2
  exit 1
}

# Use Python's email module to walk the full MIME tree and extract attachments.

python3 - "$out_dir" "$filter_name" "$list_only" "$tmp_mime" <<'PYEOF'
import sys, email, os, pathlib

out_dir   = sys.argv[1]
filter_nm = sys.argv[2]   # empty = all
list_only = sys.argv[3] == "true"
mime_file = sys.argv[4]

with open(mime_file, 'rb') as f:
    raw = f.read()
msg = email.message_from_bytes(raw)

def human_size(n):
    if n > 1_048_576: return f"{n // 1_048_576}MB"
    if n > 1024:      return f"{n // 1024}KB"
    return f"{n}B"

found = []
for part in msg.walk():
    name = part.get_filename()
    if not name:
        continue
    ct = part.get_content_type()
    cd = str(part.get("Content-Disposition", ""))
    # Skip inline parts (embedded images)
    if "inline" in cd and ct.startswith("image/"):
        continue
    # Filter by name if requested
    if filter_nm and name != filter_nm:
        continue
    payload = part.get_payload(decode=True)
    if payload is None:
        continue
    found.append((name, ct, payload))

if not found:
    if filter_nm:
        print(f"No attachment named '{filter_nm}' found.", file=sys.stderr)
        print("Run 'email download --list <id>' to see available attachments.", file=sys.stderr)
        sys.exit(1)
    else:
        print("No downloadable attachments found.")
        sys.exit(0)

if list_only:
    for name, ct, payload in found:
        print(f"  {name:<45}  {human_size(len(payload)):<8}  {ct}")
    sys.exit(0)

os.makedirs(out_dir, exist_ok=True)
for name, ct, payload in found:
    out_path = pathlib.Path(out_dir) / name
    out_path.write_bytes(payload)
    print(f"  saved: {out_path} ({human_size(len(payload))})")

PYEOF
