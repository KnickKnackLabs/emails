#!/usr/bin/env bash
#MISE description="Read an email message"
#USAGE arg "<id>" help="Message ID to read"
#USAGE flag "-f --folder <folder>" help="Folder to read from (default: INBOX)"
#USAGE flag "-s --save-attachments" help="Download attachments to agent workspace"

set -e

source "$MISE_CONFIG_ROOT/lib/email.sh"

ID="${usage_id:-$1}"
FOLDER="${usage_folder:-INBOX}"

if [ -z "$ID" ]; then
  echo "Usage: emails read <id>"
  echo ""
  echo "Find message IDs with: emails list"
  exit 1
fi

# Verify GPG signature on the raw message.
SIG_TAG=""
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

if himalaya message export --full -a "$AGENT" -f "$FOLDER" -d "$TMPDIR/msg.eml" "$ID" >/dev/null 2>&1; then
  GPG_OUTPUT=$(gpg --verify "$TMPDIR/msg.eml" 2>&1) && GPG_EXIT=0 || GPG_EXIT=$?

  if [ $GPG_EXIT -eq 0 ] && echo "$GPG_OUTPUT" | grep -q "Good signature"; then
    SIGNER=$(echo "$GPG_OUTPUT" | grep "Good signature from" | sed 's/.*Good signature from "\(.*\)".*/\1/')
    SIG_TAG="(✓ Signed by ${SIGNER})"
  elif echo "$GPG_OUTPUT" | grep -q "BAD signature"; then
    SIG_TAG="(✗ Bad signature)"
  elif echo "$GPG_OUTPUT" | grep -q "no valid OpenPGP data"; then
    SIG_TAG="(⚠ Unsigned)"
  elif echo "$GPG_OUTPUT" | grep -qi "No public key"; then
    KEY_ID=$(echo "$GPG_OUTPUT" | grep -i "using .* key" | sed 's/.*key \([A-Fa-f0-9]*\).*/\1/' | tail -c 17)
    SIG_TAG="(⚠ Signed, unknown key ${KEY_ID})"
  else
    SIG_TAG="(⚠ Could not verify signature)"
  fi
else
  SIG_TAG="(⚠ Could not verify signature)"
fi

# Read the message, stripping MML tags
OUTPUT=$(himalaya message read -a "$AGENT" -f "$FOLDER" "$ID" \
  | sed -E '/^[[:space:]]*<#\/?part/d; /^[[:space:]]*<#\/?multipart/d')

if [ -n "$SIG_TAG" ]; then
  DONE=false
  while IFS= read -r line; do
    if [[ "$DONE" == false ]] && [[ "$line" == From:* ]]; then
      echo "${line} ${SIG_TAG}"
      DONE=true
    else
      echo "$line"
    fi
  done <<< "$OUTPUT"
else
  echo "$OUTPUT"
fi

# Check for attachments
HAS_ATTACHMENT="false"
if [ -f "$TMPDIR/msg.eml" ] && grep -qi "^Content-Disposition: attachment" "$TMPDIR/msg.eml"; then
  HAS_ATTACHMENT="true"
fi

if [ "$HAS_ATTACHMENT" = "true" ]; then
  if [ "${usage_save_attachments:-false}" = "true" ]; then
    DOWNLOADS_DIR="${HOME}/agents/${AGENT}/downloads"
    mkdir -p "$DOWNLOADS_DIR"

    # mkdir -p ran above so the dir exists; ls should not fail here
    BEFORE=$(ls -1 "$DOWNLOADS_DIR")
    himalaya attachment download -a "$AGENT" -f "$FOLDER" -o plain "$ID" >/dev/null 2>&1
    AFTER=$(ls -1 "$DOWNLOADS_DIR")
    NEW_FILES=$(comm -13 <(echo "$BEFORE" | sort) <(echo "$AFTER" | sort))

    FOUND=0
    echo ""
    echo "Attachments:"
    while IFS= read -r fname; do
      [ -n "$fname" ] || continue
      f="$DOWNLOADS_DIR/$fname"
      if [[ "$fname" != *.* ]] && file -b "$f" | grep -qi "pgp\|gpg"; then
        rm -f "$f"
      else
        FOUND=$((FOUND + 1))
        echo "  $fname ($(du -h "$f" | cut -f1 | tr -d ' '))"
      fi
    done <<< "$NEW_FILES"

    if [ "$FOUND" -eq 0 ]; then
      echo "  (no attachments after filtering signatures)"
    fi
  else
    echo ""
    echo "This message has attachments. Use -s to download to ~/agents/$AGENT/downloads/"
  fi
fi
