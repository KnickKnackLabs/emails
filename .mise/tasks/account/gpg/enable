#!/usr/bin/env bash
#MISE description="Enable GPG signing for an email account"
#USAGE arg "<account>" help="Account name"
#USAGE flag "--local-user <local_user>" help="GPG local-user selector, usually the account email address"

set -euo pipefail

EMAILS_NO_ACCOUNT_RESOLUTION=1 source "$MISE_CONFIG_ROOT/lib/email.sh"
ACCOUNT_NAME="$usage_account"
LOCAL_USER="${usage_local_user:-}"

if [ -z "$LOCAL_USER" ]; then
  echo "ERROR: --local-user is required" >&2
  exit 1
fi
if [ ! -f "$CONFIG_FILE" ] || ! email_account_exists "$ACCOUNT_NAME"; then
  echo "Email account not configured: $ACCOUNT_NAME" >&2
  exit 1
fi

escape_toml() {
  sed 's/\\/\\\\/g; s/"/\\"/g'
}
ESCAPED_LOCAL_USER="$(printf '%s' "$LOCAL_USER" | escape_toml)"
SIGN_CMD="gpg --local-user '<$ESCAPED_LOCAL_USER>' --sign --quiet --armor"
DECRYPT_CMD="gpg --decrypt --quiet"
VERIFY_CMD="gpg --verify --quiet"

tmp="${CONFIG_FILE}.tmp.$$"
awk \
  -v target="$ACCOUNT_NAME" \
  -v sign_cmd="$SIGN_CMD" \
  -v decrypt_cmd="$DECRYPT_CMD" \
  -v verify_cmd="$VERIFY_CMD" '
  function emit_gpg() {
    if (in_target && emitted == 0) {
      print "pgp.type = \"commands\""
      print "pgp.sign-cmd = \"" sign_cmd "\""
      print "pgp.decrypt-cmd = \"" decrypt_cmd "\""
      print "pgp.verify-cmd = \"" verify_cmd "\""
      emitted = 1
    }
  }
  $0 ~ /^\[accounts\./ {
    emit_gpg()
    account = $0
    sub(/^\[accounts\./, "", account)
    sub(/\]$/, "", account)
    in_target = (account == target)
    emitted = 0
    print
    next
  }
  $0 ~ /^\[/ {
    emit_gpg()
    in_target = 0
    print
    next
  }
  in_target && $0 ~ /^[[:space:]]*pgp\./ { next }
  { print }
  END { emit_gpg() }
' "$CONFIG_FILE" > "$tmp"
mv "$tmp" "$CONFIG_FILE"
chmod 600 "$CONFIG_FILE"

echo "GPG signing enabled for $ACCOUNT_NAME ($LOCAL_USER)"
