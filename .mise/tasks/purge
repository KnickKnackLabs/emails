#!/usr/bin/env bash
#MISE description="Permanently delete all messages in a folder"
#USAGE arg "[folder]" default="Trash" help="Folder to purge (default: Trash)"
#USAGE flag "--force" default=#false help="Skip confirmation prompt"
#USAGE flag "--account <account>" default="" help="Email account to use"
#USAGE example "mise run purge Trash" header="Purge a folder with confirmation"

set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/email.sh"

FOLDER="${usage_folder:-Trash}"
FORCE="${usage_force:-false}"

# Count messages in folder
COUNT=$(emails_himalaya envelope list -a "$ACCOUNT" -f "$FOLDER" --page-size 1000 2>/dev/null | tail -n +4 | wc -l | tr -d ' ')

if [ "$COUNT" -eq 0 ]; then
  echo "$FOLDER is empty"
  exit 0
fi

# Confirm unless --force
if [ "$FORCE" != "true" ]; then
  echo "This will permanently delete $COUNT message(s) from $FOLDER."
  printf "Continue? [y/N] "
  read -r REPLY
  if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
    echo "Aborted"
    exit 1
  fi
fi

if [ "$FORCE" = "true" ]; then
  emails_himalaya folder purge -a "$ACCOUNT" -y "$FOLDER"
else
  emails_himalaya folder purge -a "$ACCOUNT" "$FOLDER"
fi
echo "Purged $COUNT message(s) from $FOLDER"
