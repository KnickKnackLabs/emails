#!/usr/bin/env bash
#MISE description="Deprecated: use emails account setup"

set -euo pipefail

cat >&2 <<'EOF'
emails setup is deprecated.

Create explicit account configs instead:
  printf '%s' '<password>' \
    | emails account setup personal \
        --address you@example.com \
        --imap-host imap.example.com \
        --smtp-host smtp.example.com \
        --password-stdin \
        --set-default

Use EMAILS_CONFIG or HIMALAYA_CONFIG to choose a non-default config file.
EOF
exit 1
