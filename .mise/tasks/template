#!/usr/bin/env bash
#MISE description="Print a starter TSX email template"
#USAGE arg "[name]" default="" help="Template name to print (omit to list templates)"

set -euo pipefail

TEMPLATE_NAME="${usage_name:-}"
TEMPLATE_DIR="$MISE_CONFIG_ROOT/templates"

list_templates() {
  find "$TEMPLATE_DIR" -maxdepth 1 -type f -name '*.tsx' -print \
    | sed 's#.*/##; s#\.tsx$##' \
    | sort
}

if [ -z "$TEMPLATE_NAME" ]; then
  cat <<EOF
Available email templates:
$(list_templates | sed 's/^/  - /')

Usage:
  emails template business-letter > draft.tsx
  emails compose draft.tsx > draft.html
EOF
  exit 0
fi

if ! printf '%s\n' "$TEMPLATE_NAME" | grep -Eq '^[A-Za-z0-9_-]+$'; then
  echo "ERROR: template name must contain only letters, numbers, underscore, or dash" >&2
  exit 1
fi

TEMPLATE_FILE="$TEMPLATE_DIR/$TEMPLATE_NAME.tsx"
if [ ! -f "$TEMPLATE_FILE" ]; then
  echo "ERROR: unknown template: $TEMPLATE_NAME" >&2
  echo "Available templates:" >&2
  list_templates | sed 's/^/  - /' >&2
  exit 1
fi

cat "$TEMPLATE_FILE"
