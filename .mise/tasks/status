#!/usr/bin/env bash
#MISE description="Check email account setup status"
#USAGE flag "--account <account>" default="" help="Email account to check"
#USAGE example "mise run status --account work" header="Check an account"

set -euo pipefail

# shellcheck source=lib/email.sh
EMAILS_NO_ACCOUNT_RESOLUTION=1 source "$MISE_CONFIG_ROOT/lib/email.sh"

HIMALAYA_BIN="${HIMALAYA:-himalaya}"

echo "Email status"
echo ""
echo "Config: $CONFIG_FILE"

if ! command -v "$HIMALAYA_BIN" &> /dev/null; then
  echo "Himalaya installed: ✗"
  echo ""
  echo "Run: mise install"
  exit 1
fi
echo "Himalaya installed: ✓"

if [ ! -f "$CONFIG_FILE" ]; then
  echo "Config exists: ✗"
  echo ""
  echo "Create one with: emails account setup <account> --address <address> --imap-host <imap-host> --smtp-host <smtp-host> --password-stdin"
  exit 1
fi
echo "Config exists: ✓"

accounts="$(email_account_names)"
if [ -z "$accounts" ]; then
  echo "Accounts configured: ✗"
  exit 1
fi

echo "Accounts configured:"
while IFS= read -r account; do
  [ -n "$account" ] || continue
  email="$(email_account_field "$account" email)"
  default="$(email_account_field "$account" default)"
  sign_cmd="$(email_account_field "$account" pgp.sign-cmd)"
  marker=""
  [ "$default" = "true" ] && marker=" default"
  [ -n "$sign_cmd" ] && gpg="gpg" || gpg="no-gpg"
  echo "  - $account <$email> ($gpg$marker)"
done <<< "$accounts"

unset EMAILS_NO_ACCOUNT_RESOLUTION
# shellcheck source=lib/email.sh
if source "$MISE_CONFIG_ROOT/lib/email.sh"; then
  : "${ACCOUNT:?email account resolution failed}"
  : "${ACCOUNT_EMAIL:?email account missing address}"
  echo ""
  echo "Resolved account: $ACCOUNT <$ACCOUNT_EMAIL>"
  echo "Testing connection..."
  if emails_himalaya envelope list -a "$ACCOUNT" --max-width 0 2>/dev/null | head -1 > /dev/null; then
    echo "Connection: ✓"
  else
    echo "Connection: ✗ (check credentials)"
    exit 1
  fi
else
  echo ""
  echo "Account resolution: ✗"
  exit 1
fi
