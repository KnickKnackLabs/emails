#!/usr/bin/env bash
#MISE description="Archive email message(s)"
#USAGE arg "<id>" help="Message ID to archive"
#USAGE flag "--account <account>" default="" help="Email account to use"
#USAGE example "mise run archive 42" header="Archive a message"

set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/email.sh"

ID="$usage_id"

if [ -z "$ID" ]; then
  echo "Usage: emails archive <id>"
  echo ""
  echo "Moves message to Archive folder. Find IDs with: emails list"
  exit 1
fi

# Create Archive folder if it doesn't exist
if ! emails_himalaya folder list -a "$ACCOUNT" | grep -q "^| Archive "; then
  emails_himalaya folder create -a "$ACCOUNT" Archive
fi

emails_himalaya message move -a "$ACCOUNT" Archive "$ID"
echo "Archived message $ID"
